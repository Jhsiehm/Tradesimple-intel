export type ResearchStudy = {
  id: string;
  kind: "workflow" | "policy";
  revision: number;
  title: string;
  question: string;
  status: string;
  claim: string;
  executed: boolean;
  archiveAvailable: boolean;
  plan: Record<string, unknown>;
  gaps: string[];
  limitations: string[];
  evidence: Record<string, unknown>;
  outputs: Record<string, unknown>;
  parentId?: string;
  replay?: { matches: boolean };
};
export function studyId(value: unknown): string | null;
export function cleanResearchStudies(values: unknown): ResearchStudy[];
export function studyReceipt(raw: unknown): ResearchStudy | null;
export function mergeResearchStudies(prior: unknown, incoming: unknown): ResearchStudy[];
export function latestStudyId(turns: unknown[]): string | null;
