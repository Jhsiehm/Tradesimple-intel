# Copy to .env.local. Never commit .env.local.
# Rotate any key that has been pasted into a chat.
# Every key is optional; panels that need a missing key say so.

# api.congress.gov — votes, bills, members, committees, calendar
CONGRESS_API_KEY=
# lda.senate.gov — lobbying filings
LDA_API_KEY=
# api.open.fec.gov — per-ticker PAC receipts (bulk FEC files work without it)
FEC_API_KEY=
# aisstream.io — live ship positions in the Taiwan Strait
AISSTREAM_API_KEY=
# X API v2 bearer token — real X posts (without it the X column uses Bluesky + Truth Social)
X_BEARER_TOKEN=
PORT=8787

# Posting bot (scripts/bot.mjs). Dry run unless you pass --post. Names only; never commit values.
# Bluesky: your handle and an app password (Settings → Privacy and security → App passwords)
BSKY_HANDLE=
BSKY_APP_PASSWORD=
# Optional: a PDS other than https://bsky.social
BSKY_SERVICE=
# X API v2, user context (OAuth 1.0a): app key/secret and the posting account's access token/secret
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Absolute URL of the public demo, used for share links and the card watermark
PUBLIC_URL=
# POST /api/ask, /api/backtest etc. only accept the Vite app (127.0.0.1/localhost:5173, VITE_PORT),
# loopback tools with no Origin (curl), and these comma-separated origins (e.g. http://192.168.1.5:5173).
INTEL_ALLOWED_ORIGINS=

# Ask (the ASK sheet). Off until a provider and its key are set. Keys stay on the server.
# ASK_PROVIDER is one of: anthropic, openai, compat, openrouter. Left empty with OPENROUTER_API_KEY set, it is openrouter.
ASK_PROVIDER=
# Default model. Empty means: openrouter anthropic/claude-sonnet-4.6, openai gpt-4.1, anthropic claude-sonnet-4-5.
# AGENT_MODEL is read as an alias. Small models (mini, nano, haiku, flash) work but show a warning badge.
ASK_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# compat: any OpenAI-compatible endpoint, such as the Vercel AI Gateway (https://ai-gateway.vercel.sh/v1)
ASK_BASE_URL=
ASK_API_KEY=
# openrouter: set OPENROUTER_API_KEY in this file
OPENROUTER_API_KEY=
# Monthly Ask spend cap in USD (default 20; 0 = no cap), counted per ET month from OpenRouter's reported cost, else
# tokens × the price table in shared/spend.mjs. Scheduled prompt tasks count too. From 80% answers carry a warning; at
# 100% every question runs on ASK_CHEAP_MODEL (default openai/gpt-4o-mini on OpenRouter). ASK_BUDGET_HARD_STOP=1
# refuses new questions instead.
ASK_MONTHLY_BUDGET_USD=
ASK_BUDGET_HARD_STOP=
ASK_CHEAP_MODEL=
# Minutes a finished answer may be reused for the same question and chat when its data has not changed (default 15;
# 0 = off). The sheet labels it "Reused answer from HH:MM ET" with a Re-ask button.
ASK_ANSWER_CACHE_MIN=

# Scheduled research tasks (Ask sheet > Scheduled; results post to Alerts). Backtest tasks make no model call;
# prompt tasks use ASK_STRONG_MODEL if set, else ASK_MODEL, and are skipped with an alert when no key is set.
# TASKS_MAX_RUNS_PER_DAY caps runs per ET day across all tasks (default 20). TASKS_SCHEDULER=off stops timed runs
# (Run now still works).
TASKS_MAX_RUNS_PER_DAY=
TASKS_SCHEDULER=

# Ask web search (web_search / web_fetch; pages are labeled "web, not a TradeSimple feed"). With OPENROUTER_API_KEY set
# it uses OpenRouter's web plugin (about $0.01 a search) and needs nothing else. Otherwise set one of the keys below.
# WEB_SEARCH_PROVIDER forces one of openrouter | tavily | brave, or off. WEB_SEARCH_MODEL is the cheap OpenRouter
# model that carries the plugin (default openai/gpt-4o-mini; its own text is discarded, only cited pages are kept).
WEB_SEARCH_PROVIDER=
WEB_SEARCH_MODEL=
TAVILY_API_KEY=
BRAVE_API_KEY=
