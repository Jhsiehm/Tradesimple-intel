# /etc/tradesimple/env on the VPS (root:root, mode 600). Never commit the filled-in copy.
# bootstrap.sh creates it from this file with PUBLIC_ORIGIN filled in; add the rest from your laptop with
#   scp .env.local deploy@SERVER:/tmp/intel.env && ssh -t deploy@SERVER sudo tradesimple-env /tmp/intel.env
# (see README "Hosting on a VPS"). NODE_ENV, PORT and INTEL_CACHE are set in the systemd unit.

# The address you open the app at, https:// and no trailing path. Sign-in cookies and the cross-site guard use it.
PUBLIC_ORIGIN=__ORIGIN__

# Sign-in (from `npm run auth:hash` on your laptop; add `-- --totp` for an authenticator code).
INTEL_PASSWORD_HASH=
INTEL_SESSION_SECRET=
INTEL_TOTP_SECRET=
# Days a sign-in lasts (renewed while you use it). Default 30.
INTEL_SESSION_DAYS=

# Ask spend cap in US dollars per calendar month (OpenRouter). Set this on a server that is always on.
ASK_MONTHLY_BUDGET_USD=

# Feed and model keys: same names as .env.local (see .env.example in the repo).
OPENROUTER_API_KEY=
CONGRESS_API_KEY=
LDA_API_KEY=
FEC_API_KEY=
