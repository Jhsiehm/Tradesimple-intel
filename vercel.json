{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/relay.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/relay?route=api/:path*" },
    { "source": "/geo/:path*", "destination": "/api/relay?route=geo/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
